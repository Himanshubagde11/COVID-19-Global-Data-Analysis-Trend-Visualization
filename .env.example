# Database connection configuration (PostgreSQL / SQL Server / SQLite)
DB_DIALECT=sqlite
DB_SQLITE_PATH=data/covid_analytics.db

# PostgreSQL configuration (if using remote / local Postgres)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=covid_analytics
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# Pipeline Settings
CHUNK_SIZE=50000
LOG_LEVEL=INFO
